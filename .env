# ==============================================================================
# Chanakya Environment Configuration (.env.example)
# Sovereign Mathematical Optimization Solver
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=production
DEBUG=false
APP_NAME=Chanakya
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
PUBLIC_URL=http://localhost:8080

# Layer 2: Transport & Edge
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","https://chanakya.gov.in"]
SECRET_KEY=change-me-to-a-super-secret-cryptographically-random-256-bit-key-min-64-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Layer 3: Traffic Control & Anti-DoS
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=5
MAX_BODY_SIZE_BYTES=52428800 # 50 Megabytes limit
MAX_CONCURRENT_JOBS_PER_USER=5

# Layer 5 & 7: PostgreSQL Database (Strict Parameterized Queries)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=chanakya_app
POSTGRES_PASSWORD=chanakya_secure_pass_change_in_prod
POSTGRES_DB=chanakya_db
DATABASE_URL=postgresql+asyncpg://chanakya_app:chanakya_secure_pass_change_in_prod@localhost:5432/chanakya_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_STATEMENT_TIMEOUT_MS=15000

# Redis Cache, Streams & Rate Limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=chanakya_redis_pass_change_in_prod
REDIS_URL=redis://:chanakya_redis_pass_change_in_prod@localhost:6379/0

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_secure_change_me
S3_BUCKET_MODELS=chanakya-models
S3_BUCKET_RESULTS=chanakya-results
S3_REGION=ap-south-1
S3_USE_SSL=false

# Solver Worker Sandbox Limits
WORKER_CPU_LIMIT=4
WORKER_MEMORY_LIMIT_MB=8192
WORKER_DEFAULT_TIMEOUT_S=600
WORKER_MAX_TIMEOUT_S=3600
